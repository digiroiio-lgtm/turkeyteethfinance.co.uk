# Public canonical origin; set before building.
NEXT_PUBLIC_SITE_URL=https://turkeyteethfinance.co.uk

# Production search indexing is enabled independently of finance approval.
# Set false for a deliberate search hold. Vercel preview builds stay noindex.
SITE_INDEXING_ENABLED=true

# Finance publication is disabled by default. Set only after written approval.
SITE_CONTENT_APPROVED=false
APPROVED_FINANCE_DISCLOSURE=
FINANCE_APPLICATION_URL=

# Private enquiry receiver, not an email address or a public automation webhook.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEADS_DELIVERY_VERIFIED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supply reviewed notices before enabling collection of patient information.
PRIVACY_CONTACT_EMAIL=
PRIVACY_RETENTION_NOTICE=
PRIVACY_PROCESSORS_NOTICE=
PRIVACY_TRANSFER_NOTICE=

# Optional ownership verification and changed-URL submission.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
