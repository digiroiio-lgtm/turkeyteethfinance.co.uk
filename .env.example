# Public canonical origin; set before building.
NEXT_PUBLIC_SITE_URL=https://turkeyteethfinance.co.uk

# Production search indexing is enabled independently of finance approval.
# Set false for a deliberate search hold. Vercel preview builds stay noindex.
SITE_INDEXING_ENABLED=true

# Finance publication is disabled by default. Set only after written approval.
SITE_CONTENT_APPROVED=false
APPROVED_FINANCE_DISCLOSURE=
FINANCE_APPLICATION_URL=

# React form -> local API -> Formspree. The endpoint is public, not a secret.
ENQUIRY_DELIVERY_PROVIDER=formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/xgaojavy
# Set false to pause either enquiry provider deliberately.
ENQUIRY_DELIVERY_ENABLED=true
# Optional custom widget: configure the matching secret in Formspree before setting this.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional existing signed-webhook transport: ENQUIRY_DELIVERY_PROVIDER=webhook.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
# Webhook activation only, after receiver verification.
LEADS_DELIVERY_VERIFIED=false

# Optional public notice overrides; required for the explicit webhook provider.
PRIVACY_CONTACT_EMAIL=
PRIVACY_RETENTION_NOTICE=
PRIVACY_PROCESSORS_NOTICE=
PRIVACY_TRANSFER_NOTICE=

# Optional ownership verification and changed-URL submission.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
